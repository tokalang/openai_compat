// One completed SSE event -> ordered Chat Completions semantic events.
// HTTP framing stays in stdx/net/sse; transport stays with the application.

import core/option::{Option}
import core/result::{Result}
import official/openai_compat/types::{OpenAiApiError, OpenAiCompatError, OpenAiCompatLimits, OpenAiStreamEvent, OpenAiToolCallDelta, OpenAiUsage}
import std/vec::{Vec}
import stdx/net/sse::{SseEvent}
import stdx/serde/json_document::{Document, parse_document}

fn string_node(doc: Document, id: usize) -> Option<string> {
    if id != 0 && doc.kind(id) == 3 {
        return Option<string>::Some(string::from(doc.text(id)))
    }
    return Option<string>::None
}

fn integer_node(doc: Document, id: usize) -> Option<i32> {
    if id != 0 && doc.kind(id) == 2 {
        auto number = doc.number(id).unwrap()
        if number < 0.0 || number > 2147483647.0 { return Option<i32>::None }
        return Option<i32>::Some(number as i32)
    }
    return Option<i32>::None
}

fn usage_number(doc: Document, id: usize) -> Option<usize> {
    if id != 0 && doc.kind(id) == 2 {
        auto number = doc.number(id).unwrap()
        if number < 0.0 || number > 2147483647.0 { return Option<usize>::None }
        auto whole = number as i32
        if whole as f64 != number { return Option<usize>::None }
        return Option<usize>::Some(whole as usize)
    }
    return Option<usize>::None
}

fn decode_usage(doc: Document, id: usize) -> Result<OpenAiUsage, OpenAiCompatError> {
    if doc.kind(id) != 5 {
        return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage must be an object"))
    }
    auto prompt_node = doc.find(id, "prompt_tokens")
    auto completion_node = doc.find(id, "completion_tokens")
    auto total_node = doc.find(id, "total_tokens")
    if prompt_node == 0 || completion_node == 0 || total_node == 0 {
        return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage is missing token counts"))
    }
    auto prompt = usage_number(doc, prompt_node)
    auto completion = usage_number(doc, completion_node)
    auto total = usage_number(doc, total_node)
    if prompt.is_none() || completion.is_none() || total.is_none() {
        return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage token counts must be non-negative integers"))
    }
    return OpenAiUsage::new(prompt.unwrap(), completion.unwrap(), total.unwrap())
}

fn decode_tool_call(doc: Document, call_node: usize) -> Result<OpenAiToolCallDelta, OpenAiCompatError> {
    if doc.kind(call_node) != 5 {
        return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call must be an object"))
    }
    auto index_node = doc.find(call_node, "index")
    if index_node == 0 {
        return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call delta is missing index"))
    }
    auto index = integer_node(doc, index_node)
    if index.is_none() {
        return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call index must be a non-negative integer"))
    }
    auto id_node = doc.find(call_node, "id")
    auto tool_id# = Option<string>::None
    if id_node != 0 {
        auto decoded_id = string_node(doc, id_node)
        if decoded_id.is_none() {
            return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call id must be string"))
        }
        tool_id = cede decoded_id
    }
    auto name# = Option<string>::None
    auto arguments# = Option<string>::None
    auto function_node = doc.find(call_node, "function")
    if function_node != 0 {
        if doc.kind(function_node) != 5 {
            return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function must be an object"))
        }
        auto name_node = doc.find(function_node, "name")
        if name_node != 0 {
            auto decoded_name = string_node(doc, name_node)
            if decoded_name.is_none() {
                return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function name must be string"))
            }
            name = cede decoded_name
        }
        auto arguments_node = doc.find(function_node, "arguments")
        if arguments_node != 0 {
            auto decoded_args = string_node(doc, arguments_node)
            if decoded_args.is_none() {
                return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function arguments must be string"))
            }
            arguments = cede decoded_args
        }
    }
    return Result<OpenAiToolCallDelta, OpenAiCompatError>::Ok(OpenAiToolCallDelta::new(index.unwrap(), cede tool_id, cede name, cede arguments))
}

fn decode_choice(doc: Document, id: usize, limit: usize, events#: Vec<OpenAiStreamEvent>) -> Result<(), OpenAiCompatError> {
    if doc.kind(id) != 5 {
        return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible choice must be an object"))
    }
    auto choice_index = doc.find(id, "index")
    if choice_index != 0 {
        auto index = integer_node(doc, choice_index)
        if index.is_none() {
            return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports only choice index zero"))
        }
        if index.unwrap() != 0:i32 {
            return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports only choice index zero"))
        }
    }
    auto delta_node = doc.find(id, "delta")
    if delta_node != 0 {
        if doc.kind(delta_node) != 5 {
            return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta must be an object"))
        }
        auto role_node = doc.find(delta_node, "role")
        if role_node != 0 {
            auto role = string_node(doc, role_node)
            if role.is_none() {
                return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta role must be string"))
            }
            events#.push(cede OpenAiStreamEvent::RoleDelta(role.unwrap()))
        }
        auto content_node = doc.find(delta_node, "content")
        if content_node != 0 {
            auto content = string_node(doc, content_node)
            if content.is_none() {
                return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta content must be string"))
            }
            events#.push(cede OpenAiStreamEvent::TextDelta(content.unwrap()))
        }
        auto refusal_node = doc.find(delta_node, "refusal")
        if refusal_node != 0 {
            auto refusal = string_node(doc, refusal_node)
            if refusal.is_none() {
                return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta refusal must be string"))
            }
            events#.push(cede OpenAiStreamEvent::RefusalDelta(refusal.unwrap()))
        }
        auto calls_node = doc.find(delta_node, "tool_calls")
        if calls_node != 0 {
            if doc.kind(calls_node) != 4 {
                return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool_calls must be an array"))
            }
            auto call_child# = doc.first(calls_node)
            auto call_count# = 0:usize
            loop call_child != 0 {
                call_count += 1
                if call_count > limit {
                    return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible chunk has too many tool calls"))
                }
                auto decoded = decode_tool_call(doc, call_child)
                if decoded.is_err() { return Result<(), OpenAiCompatError>::Err(decoded.unwrap_err()) }
                events#.push(cede OpenAiStreamEvent::ToolCallDelta(decoded.unwrap()))
                call_child = doc.next(call_child)
            }
        }
    }
    auto finish_node = doc.find(id, "finish_reason")
    if finish_node != 0 {
        if doc.kind(finish_node) == 0 {
            // null
        } else if doc.kind(finish_node) == 3 {
            events#.push(cede OpenAiStreamEvent::Completed(Option<string>::Some(string::from(doc.text(finish_node)))))
        } else {
            return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible finish_reason must be string or null"))
        }
    }
    return Result<(), OpenAiCompatError>::Ok(())
}

// Decode one SSE data event from the OpenAI-compatible `/v1/chat/completions`
// streaming profile. `[DONE]` is provider policy, not an SSE framing rule.
pub fn decode_sse_event(cede input: SseEvent, limits: OpenAiCompatLimits) -> Result<Vec<OpenAiStreamEvent>, OpenAiCompatError> {
    auto event = cede input
    auto data = event.data()
    if data.as_str().equals("[DONE]") {
        auto completed# = Vec<OpenAiStreamEvent>::new()
        completed#.push(cede OpenAiStreamEvent::Completed(Option<string>::None))
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Ok(cede completed)
    }
    if data.len() > limits.max_json_bytes() {
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible SSE JSON exceeds configured byte limit"))
    }
    auto parsed = parse_document(data.as_str())
    if parsed.is_err() {
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("json", "OpenAI-compatible SSE data is invalid JSON"))
    }
    auto doc = parsed.unwrap()
    auto root = 1:usize
    if doc.kind(root) != 5 {
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible SSE root must be an object"))
    }
    auto provider_error = doc.find(root, "error")
    if provider_error != 0 {
        if doc.kind(provider_error) != 5 {
            return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error must be an object"))
        }
        auto message_node = doc.find(provider_error, "message")
        if message_node == 0 {
            return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error is missing message"))
        }
        auto message = string_node(doc, message_node)
        if message.is_none() {
            return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error message must be string"))
        }
        auto kind# = Option<string>::None
        auto kind_node = doc.find(provider_error, "type")
        if kind_node != 0 {
            auto decoded_kind = string_node(doc, kind_node)
            if decoded_kind.is_none() {
                return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error type must be string"))
            }
            kind = cede decoded_kind
        }
        auto code# = Option<string>::None
        auto code_node = doc.find(provider_error, "code")
        if code_node != 0 {
            auto decoded_code = string_node(doc, code_node)
            if decoded_code.is_none() {
                return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error code must be string"))
            }
            code = cede decoded_code
        }
        auto api_events# = Vec<OpenAiStreamEvent>::new()
        api_events#.push(cede OpenAiStreamEvent::ApiError(OpenAiApiError::new(cede message.unwrap(), cede kind, cede code)))
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Ok(cede api_events)
    }
    auto events# = Vec<OpenAiStreamEvent>::new()
    auto usage_node = doc.find(root, "usage")
    if usage_node != 0 {
        auto usage = decode_usage(doc, usage_node)
        if usage.is_err() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(usage.unwrap_err()) }
        events#.push(cede OpenAiStreamEvent::Usage(usage.unwrap()))
    }
    auto choices_node = doc.find(root, "choices")
    if choices_node == 0 {
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible chunk is missing choices"))
    }
    if doc.kind(choices_node) != 4 {
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible choices must be an array"))
    }
    auto choice_child# = doc.first(choices_node)
    auto choice_count# = 0:usize
    loop choice_child != 0 {
        choice_count += 1
        if choice_count > 1:usize {
            return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports one choice per stream chunk"))
        }
        auto decoded = decode_choice(doc, choice_child, limits.max_tool_calls_per_chunk(), events#)
        if decoded.is_err() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(decoded.unwrap_err()) }
        choice_child = doc.next(choice_child)
    }
    return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Ok(cede events)
}
