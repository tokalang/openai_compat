// One non-streaming Chat Completions JSON response -> owned protocol result.

import core/option::{Option}
import core/result::{Result}
import official/openai_compat/types::{OpenAiApiError, OpenAiAssistantTurn, OpenAiCompatError, OpenAiCompatLimits, OpenAiCompletion, OpenAiToolCall, OpenAiUsage}
import std/vec::{Vec}
import stdx/serde/json_document::{Document, parse_document}

fn required_string(doc: Document, id: usize, field: str) -> Result<string, OpenAiCompatError> {
    if doc.kind(id) == 3 {
        return Result<string, OpenAiCompatError>::Ok(string::from(doc.text(id)))
    }
    return Result<string, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", field))
}

fn optional_string(doc: Document, id: usize, field: str) -> Result<Option<string>, OpenAiCompatError> {
    if id == 0 || doc.kind(id) == 0 {
        return Result<Option<string>, OpenAiCompatError>::Ok(Option<string>::None)
    }
    if doc.kind(id) == 3 {
        return Result<Option<string>, OpenAiCompatError>::Ok(Option<string>::Some(string::from(doc.text(id))))
    }
    return Result<Option<string>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", field))
}

fn usage_number(doc: Document, id: usize) -> Option<usize> {
    if doc.kind(id) != 2 { return Option<usize>::None }
    auto number = doc.number(id).unwrap()
    if number < 0.0 || number > 2147483647.0 { return Option<usize>::None }
    auto whole = number as i32
    if whole as f64 != number { return Option<usize>::None }
    return Option<usize>::Some(whole as usize)
}

fn decode_usage(doc: Document, id: usize) -> Result<OpenAiUsage, OpenAiCompatError> {
    if doc.kind(id) != 5 {
        return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage must be an object"))
    }
    auto prompt_node = doc.find(id, "prompt_tokens")
    auto completion_node = doc.find(id, "completion_tokens")
    auto total_node = doc.find(id, "total_tokens")
    if prompt_node == 0 || completion_node == 0 || total_node == 0 {
        return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage is missing token counts"))
    }
    auto prompt = usage_number(doc, prompt_node)
    auto completion = usage_number(doc, completion_node)
    auto total = usage_number(doc, total_node)
    if prompt.is_none() || completion.is_none() || total.is_none() {
        return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage token counts must be non-negative integers"))
    }
    return OpenAiUsage::new(prompt.unwrap(), completion.unwrap(), total.unwrap())
}

fn decode_tool_call(doc: Document, id: usize) -> Result<OpenAiToolCall, OpenAiCompatError> {
    if doc.kind(id) != 5 {
        return Result<OpenAiToolCall, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call must be an object"))
    }
    auto id_node = doc.find(id, "id")
    auto type_node = doc.find(id, "type")
    auto function_node = doc.find(id, "function")
    if id_node == 0 || type_node == 0 || function_node == 0 {
        return Result<OpenAiToolCall, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call is missing id, type, or function"))
    }
    auto id_str = required_string(doc, id_node, "OpenAI-compatible tool call id must be string")
    auto kind_str = required_string(doc, type_node, "OpenAI-compatible tool call type must be string")
    if id_str.is_err() { return Result<OpenAiToolCall, OpenAiCompatError>::Err(id_str.unwrap_err()) }
    if kind_str.is_err() { return Result<OpenAiToolCall, OpenAiCompatError>::Err(kind_str.unwrap_err()) }
    if !kind_str.unwrap().as_str().equals("function") {
        return Result<OpenAiToolCall, OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports only function tool calls"))
    }
    if doc.kind(function_node) != 5 {
        return Result<OpenAiToolCall, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function must be an object"))
    }
    auto name_node = doc.find(function_node, "name")
    auto args_node = doc.find(function_node, "arguments")
    if name_node == 0 || args_node == 0 {
        return Result<OpenAiToolCall, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function is missing name or arguments"))
    }
    auto name_str = required_string(doc, name_node, "OpenAI-compatible tool name must be string")
    auto args_str = required_string(doc, args_node, "OpenAI-compatible tool arguments must be string")
    if name_str.is_err() { return Result<OpenAiToolCall, OpenAiCompatError>::Err(name_str.unwrap_err()) }
    if args_str.is_err() { return Result<OpenAiToolCall, OpenAiCompatError>::Err(args_str.unwrap_err()) }
    return OpenAiToolCall::new(id_str.unwrap().as_str(), name_str.unwrap().as_str(), args_str.unwrap().as_str())
}

fn decode_message(doc: Document, id: usize, limits: OpenAiCompatLimits) -> Result<OpenAiAssistantTurn, OpenAiCompatError> {
    if doc.kind(id) != 5 {
        return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible choice message must be an object"))
    }
    auto role_node = doc.find(id, "role")
    auto content_node = doc.find(id, "content")
    if role_node == 0 || content_node == 0 {
        return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible message is missing role or content"))
    }
    auto role_str = required_string(doc, role_node, "OpenAI-compatible message role must be string")
    if role_str.is_err() { return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(role_str.unwrap_err()) }
    auto role_val = role_str.unwrap()
    if !role_val.as_str().equals("assistant") {
        return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 completion message role must be assistant"))
    }
    auto content_str = optional_string(doc, content_node, "OpenAI-compatible message content must be string or null")
    if content_str.is_err() { return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(content_str.unwrap_err()) }
    auto refusal# = Option<string>::None
    auto refusal_node = doc.find(id, "refusal")
    if refusal_node != 0 {
        auto decoded_refusal = optional_string(doc, refusal_node, "OpenAI-compatible message refusal must be string or null")
        if decoded_refusal.is_err() { return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(decoded_refusal.unwrap_err()) }
        refusal = decoded_refusal.unwrap()
    }
    auto calls# = Vec<OpenAiToolCall>::new()
    auto calls_node = doc.find(id, "tool_calls")
    if calls_node != 0 {
        if doc.kind(calls_node) != 4 {
            return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible message tool_calls must be an array"))
        }
        auto call_child# = doc.first(calls_node)
        auto call_count# = 0:usize
        loop call_child != 0 {
            call_count += 1
            if call_count > limits.max_tool_calls_per_chunk() {
                return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible completion has too many tool calls"))
            }
            auto decoded = decode_tool_call(doc, call_child)
            if decoded.is_err() { return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(decoded.unwrap_err()) }
            calls#.push(cede decoded.unwrap())
            call_child = doc.next(call_child)
        }
    }
    auto none_reason = Option<string>::None
    auto none_usage = Option<OpenAiUsage>::None
    auto some_role = Option<string>::Some(cede role_val)
    auto content_val = content_str.unwrap()
    return Result<OpenAiAssistantTurn, OpenAiCompatError>::Ok(OpenAiAssistantTurn::new(cede some_role, cede content_val, cede refusal, cede calls, cede none_reason, cede none_usage))
}

fn decode_provider_error(doc: Document, id: usize) -> Result<OpenAiApiError, OpenAiCompatError> {
    if doc.kind(id) != 5 {
        return Result<OpenAiApiError, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error must be an object"))
    }
    auto message_node = doc.find(id, "message")
    if message_node == 0 {
        return Result<OpenAiApiError, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error is missing message"))
    }
    auto message = required_string(doc, message_node, "OpenAI-compatible error message must be string")
    if message.is_err() { return Result<OpenAiApiError, OpenAiCompatError>::Err(message.unwrap_err()) }
    auto kind# = Option<string>::None
    auto kind_node = doc.find(id, "type")
    if kind_node != 0 {
        auto decoded_kind = optional_string(doc, kind_node, "OpenAI-compatible error type must be string or null")
        if decoded_kind.is_err() { return Result<OpenAiApiError, OpenAiCompatError>::Err(decoded_kind.unwrap_err()) }
        kind = decoded_kind.unwrap()
    }
    auto code# = Option<string>::None
    auto code_node = doc.find(id, "code")
    if code_node != 0 {
        auto decoded_code = optional_string(doc, code_node, "OpenAI-compatible error code must be string or null")
        if decoded_code.is_err() { return Result<OpenAiApiError, OpenAiCompatError>::Err(decoded_code.unwrap_err()) }
        code = decoded_code.unwrap()
    }
    return Result<OpenAiApiError, OpenAiCompatError>::Ok(OpenAiApiError::new(cede message.unwrap(), cede kind, cede code))
}

pub fn decode_completion_json(input: str, limits: OpenAiCompatLimits) -> Result<OpenAiCompletion, OpenAiCompatError> {
    if input.len() > limits.max_json_bytes() {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible completion JSON exceeds configured byte limit"))
    }
    auto parsed = parse_document(input)
    if parsed.is_err() {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("json", "OpenAI-compatible completion is invalid JSON"))
    }
    auto doc = parsed.unwrap()
    auto root = 1:usize
    if doc.kind(root) != 5 {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible completion root must be an object"))
    }
    auto error_node = doc.find(root, "error")
    if error_node != 0 {
        auto provider_error = decode_provider_error(doc, error_node)
        if provider_error.is_err() { return Result<OpenAiCompletion, OpenAiCompatError>::Err(provider_error.unwrap_err()) }
        return Result<OpenAiCompletion, OpenAiCompatError>::Ok(OpenAiCompletion::ApiError(provider_error.unwrap()))
    }
    auto choices_node = doc.find(root, "choices")
    if choices_node == 0 {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible completion is missing choices"))
    }
    if doc.kind(choices_node) != 4 {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible completion choices must be an array"))
    }
    auto first_choice = doc.first(choices_node)
    if first_choice == 0 || doc.next(first_choice) != 0 {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 completion requires exactly one choice"))
    }
    if doc.kind(first_choice) != 5 {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible completion choice must be an object"))
    }
    auto index_node = doc.find(first_choice, "index")
    if index_node != 0 {
        if doc.kind(index_node) != 2 {
            return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible choice index must be zero"))
        }
        if doc.number(index_node).unwrap() != 0.0 {
            return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports only choice index zero"))
        }
    }
    auto message_node = doc.find(first_choice, "message")
    auto finish_node = doc.find(first_choice, "finish_reason")
    if message_node == 0 || finish_node == 0 {
        return Result<OpenAiCompletion, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible completion choice is missing message or finish_reason"))
    }
    auto turn = decode_message(doc, message_node, limits.clone())
    if turn.is_err() { return Result<OpenAiCompletion, OpenAiCompatError>::Err(turn.unwrap_err()) }
    auto reason = optional_string(doc, finish_node, "OpenAI-compatible finish_reason must be string or null")
    if reason.is_err() { return Result<OpenAiCompletion, OpenAiCompatError>::Err(reason.unwrap_err()) }
    auto usage# = Option<OpenAiUsage>::None
    auto usage_node = doc.find(root, "usage")
    if usage_node != 0 {
        auto decoded_usage = decode_usage(doc, usage_node)
        if decoded_usage.is_err() { return Result<OpenAiCompletion, OpenAiCompatError>::Err(decoded_usage.unwrap_err()) }
        usage = Option<OpenAiUsage>::Some(decoded_usage.unwrap())
    }
    auto result = turn.unwrap()
    auto role = result.role()
    auto content = result.content()
    auto refusal = result.refusal()
    auto calls = result.tool_calls()
    auto reason_val = reason.unwrap()
    return Result<OpenAiCompletion, OpenAiCompatError>::Ok(OpenAiCompletion::AssistantTurn(OpenAiAssistantTurn::new(cede role, cede content, cede refusal, cede calls, cede reason_val, cede usage)))
}
